{
  "name": "일일 AI 마켓 인사이트",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "매일 오전 9시",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8090/api/n8n/daily-insight",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-daily-insight",
      "name": "AI 인사이트 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-sent",
              "leftValue": "={{ $json.sent }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-sent",
      "name": "발송 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "매일 오전 9시": {
      "main": [
        [{ "node": "AI 인사이트 생성", "type": "main", "index": 0 }]
      ]
    },
    "AI 인사이트 생성": {
      "main": [
        [{ "node": "발송 확인", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Seoul",
    "saveManualExecutions": true
  }
}
